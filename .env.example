# ODBC DSN configured on the machine where the sample runs.
CONNX_RMS_DSN=CONNX_RMS
CONNX_RMS_TABLE=RMS.dbo.customers_rms

# Optional credentials. Leave blank when the DSN handles authentication.
CONNX_RMS_USER=
CONNX_RMS_PASSWORD=

# Optional additional ODBC connection-string attributes, e.g. "ReadOnly=Yes".
CONNX_RMS_EXTRA_CONNECTION_STRING=
CONNX_RMS_CONNECT_TIMEOUT_SECONDS=15
CONNX_RMS_QUERY_TIMEOUT_SECONDS=30

# Java-only: CONNX JDBC URL, e.g. jdbc:connx:DSN=<jdbc-dsn>;Gateway=<jdbc-server-host>;PORT=7502
CONNX_RMS_JDBC_URL=
CONNX_RMS_JDBC_USER=
CONNX_RMS_JDBC_PASSWORD=

# API settings
CONNX_RMS_API_HOST=127.0.0.1
CONNX_RMS_API_PORT=8000
CONNX_RMS_LOG_LEVEL=INFO
